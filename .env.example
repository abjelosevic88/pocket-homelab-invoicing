# Copy to .env and adjust. Every value is optional; defaults work for `docker compose up`.

# ---- server ----
TZ=Europe/Berlin
BASE_URL=https://invoices.example.com   # public URL used in emails and client links
PORT=8080
LOG_LEVEL=info                           # debug | info | warn | error
LOG_FORMAT=text                          # text | json
TRUST_PROXY=true                         # honour X-Forwarded-* from your reverse proxy
METRICS_ENABLED=true                     # Prometheus metrics at /metrics
SECURE_COOKIES=false                     # set true when served over HTTPS

# ---- storage ----
DATA_DIR=/data                           # SQLite db, uploads/, backups/
# DB_PATH=/data/pocket-invoicing.db

# ---- auth ----
AUTH_MODE=local                          # local (built-in login) | proxy (trust header) | none (no auth, LAN only!)
AUTH_PROXY_HEADER=Remote-User            # for AUTH_MODE=proxy (Authelia/Authentik/Caddy forward_auth)
AUTH_PROXY_EMAIL_HEADER=Remote-Email
SESSION_TTL=720h
# ADMIN_EMAIL=you@example.com            # bootstrap admin instead of using the setup wizard
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Admin

# ---- PDF ----
PDF_ENGINE=native                        # native (pure Go, default) | chromium | gotenberg
CHROMIUM_PATH=chromium                   # for PDF_ENGINE=chromium
GOTENBERG_URL=http://gotenberg:3000      # for PDF_ENGINE=gotenberg and Word templates
DOCX_CONVERTER=gotenberg                 # Word templates -> PDF: gotenberg (default) | libreoffice | none
LIBREOFFICE_PATH=soffice                 # for DOCX_CONVERTER=libreoffice

# ---- currencies ----
EXCHANGE_RATE_PROVIDER=frankfurter       # frankfurter (ECB) | cbbh (Central Bank of BiH) | none (manual rates only); Settings can override
EXCHANGE_RATE_REFRESH=12h

# ---- scheduler (recurring invoices, overdue, reminders, rates) ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=15m

# ---- misc ----
DEMO_DATA=false                          # seed sample clients/invoices on first start
